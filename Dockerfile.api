# Serves the evedesign-server REST API with uvicorn behind a reverse proxy.
# Only the [api] extra is installed (no evedesign/torch), like api_image in modal.py.
FROM python:3.12-slim

# branch, tag or commit SHA — pin a SHA for reproducible builds
# ARG SERVER_REF=develop
# reactivate for installing from GitHub repo
# RUN pip install --no-cache-dir \
#    "evedesign_server[api] @ https://github.com/evedesignbio/evedesign-server/archive/${SERVER_REF}.tar.gz"

COPY . /src
RUN pip install --no-cache-dir "/src[api]" && rm -rf /src

RUN useradd --system --uid 10001 app
USER app

# uvicorn reads FORWARDED_ALLOW_IPS (default 127.0.0.1,::1) and WEB_CONCURRENCY (default 1)
# from the environment and trusts proxy headers by default; set FORWARDED_ALLOW_IPS to the
# proxy's IP/CIDR at deploy time. Never "*" where the port is reachable directly.
EXPOSE 8000
CMD ["uvicorn", "evedesign_server.api.app:web_app", "--host", "0.0.0.0", "--port", "8000"]